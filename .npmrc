# pnpm 12 settings
# `onlyBuiltDependencies` allowlist replaces the legacy
# `ignoredBuiltDependencies` deny list. We trust the lifecycle
# scripts of @biomejs/biome (postinstall binary download) and
# esbuild (platform-specific binary install); everything else
# stays default-deny.
only-built-dependencies[]=@biomejs/biome
only-built-dependencies[]=esbuild
